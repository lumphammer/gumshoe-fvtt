{
  "extends": "./packages/shared-fvtt-bits/dotfiles/import/tsconfig.fvtt.json",
  // e2e has its own project, because its `page.evaluate` code sees Foundry
  // after the game is ready
  "exclude": ["packages", "e2e"],
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    // "noErrorTruncation": true
    // "skipLibCheck": false,
    "noImplicitAny": false,
    // plain React JSX, not Emotion's (the shared config's default)
    "jsxImportSource": "react",
    "paths": {},
  },
  "references": [
    { "path": "./packages/shared-fvtt-bits" },
    { "path": "./packages/investigator-fvtt-types" },
    { "path": "./packages/minirouter" },
  ],
}
