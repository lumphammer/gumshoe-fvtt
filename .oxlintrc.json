{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/shared-fvtt-bits/dotfiles/import/oxlint.config.json"],
  "plugins": ["typescript", "react"],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "src/*.js",
    "**/build",
    "**/dist",
    "**/node_modules",
    "*/**/*.eslintrc*.?js",
    "packages/shared-fvtt-bits/dotfiles/copy"
  ],
  "overrides": [
    {
      // Playwright fixtures take a `use` callback, which isn't a React hook
      "files": ["e2e/**"],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    },
    {
      "files": ["**/*.js"],
      "rules": {
        "typescript/no-var-requires": "off"
      }
    },
    {
      "files": ["packages/shared-fvtt-bits/task-core/tasks/declarations.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
