{
  "private": false,
  "name": "investigator-fvtt",
  "version": "10.118",
  "type": "module",
  "description": "Official GUMSHOE support for FoundryVTT. Ships with compatiblity for several settings, and can be customized to work with any other setting.",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "build:watch": "vite build --watch --mode dev",
    "link": "./tasks.ts link",
    "dev": "concurrently --names vite,ts --prefix-colors magenta,blue 'vite dev --clearScreen false' 'pnpm run typecheck:watch'",
    "start": "pnpm dev",
    "clean": "./tasks.ts clean",
    "build-pack-translations": "./tasks.ts buildPackTranslations",
    "pull-translations": "tx pull --workers 16 --force -all",
    "test-types": "vitest --typecheck.only",
    "test": "vitest",
    "format:check": "prettier --check src",
    "format:fix": "prettier --write src",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsgo --build --force",
    "typecheck:watch": "tsgo --build --watch --preserveWatchOutput",
    "env": "env",
    "pwd": "pwd",
    "do-prerelease": "./packages/shared-fvtt-bits/scripts/do-prerelease.sh",
    "do-full-release": "./packages/shared-fvtt-bits/scripts/do-full-release.sh",
    "update-legacy-release-branch": "./scripts/update-legacy-release-branch.sh",
    "extract-packs": "./tasks.ts extractPacks",
    "check": "pnpm run typecheck && pnpm run test --run && pnpm run lint:check && pnpm run format:check && pnpm run build"
  },
  "author": "",
  "license": "",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@lumphammer/investigator-fvtt-types": "workspace:^",
    "@lumphammer/minirouter": "workspace:^",
    "@lumphammer/shared-fvtt-bits": "workspace:^",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-switch": "^1.3.7",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@swc/plugin-emotion": "10.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/d3-ease": "^3.0.2",
    "@types/html-escaper": "^3.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/textdiff-create": "^1.0.2",
    "@types/textdiff-patch": "^1.0.2",
    "@types/turndown": "^5.0.6",
    "@types/yamljs": "^0.2.34",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react-swc": "3.11.0",
    "@vitest/ui": "^4.1.10",
    "case": "^1.6.3",
    "concurrently": "^10.0.5",
    "d3-ease": "^3.0.1",
    "focusable-selectors": "^0.8.4",
    "fvtt-types": "github:league-of-foundry-developers/foundry-vtt-types#469972f860cb2f422011027d363ce9c9aac205be",
    "happy-dom": "^20.11.2",
    "html-escaper": "^3.0.3",
    "immer": "^11.1.16",
    "jest-diff": "^30.4.1",
    "json5": "^2.2.3",
    "less": "4.4.1",
    "marked": "^18.0.9",
    "nanoid": "^6.0.1",
    "npm": "^12.0.2",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "textdiff-create": "^1.1.11",
    "textdiff-patch": "^1.1.10",
    "tsx": "^4.23.12",
    "turndown": "^7.2.4",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^3.2.4",
    "xss": "^1.0.15",
    "yamljs": "^0.3.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2",
      "onFail": "download"
    }
  },
  "devDependencies": {}
}
