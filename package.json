{
  "private": false,
  "name": "investigator-fvtt",
  "version": "10.129",
  "type": "module",
  "description": "Official GUMSHOE support for FoundryVTT. Ships with compatiblity for several settings, and can be customized to work with any other setting.",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "build:watch": "vite build --watch --mode dev",
    "link": "./tasks.ts link",
    "dev": "concurrently --kill-others --kill-timeout 5000 --names vite,ts --prefix-colors magenta,blue 'vite dev --clearScreen false' 'tsc --build --watch --preserveWatchOutput . e2e'",
    "start": "pnpm dev",
    "clean": "./tasks.ts clean",
    "build-pack-translations": "./tasks.ts buildPackTranslations",
    "pull-translations": "tx pull --workers 16 --force -all",
    "test-types": "vitest --typecheck.only",
    "e2e": "playwright test",
    "e2e:foundry": "./scripts/e2e-foundry.sh",
    "test": "vitest",
    "format:check": "oxfmt --check src",
    "format:fix": "oxfmt --write src",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --build --force . e2e",
    "typecheck:watch": "tsc --build --watch --preserveWatchOutput . e2e",
    "env": "env",
    "pwd": "pwd",
    "knip": "knip",
    "do-prerelease": "./packages/shared-fvtt-bits/scripts/do-prerelease.sh",
    "do-full-release": "./packages/shared-fvtt-bits/scripts/do-full-release.sh",
    "update-legacy-release-branch": "./scripts/update-legacy-release-branch.sh",
    "extract-packs": "./tasks.ts extractPacks",
    "check": "pnpm run typecheck && pnpm run test --run && pnpm run lint:check && pnpm run format:check && pnpm run build"
  },
  "author": "",
  "license": "",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/big-shoulders-text": "^5.3.0",
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@fontsource/averia-libre": "^5.3.0",
    "@fontsource/averia-serif-libre": "^5.3.0",
    "@fontsource/cormorant-unicase": "^5.3.0",
    "@fontsource/federo": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/nova-square": "^5.3.0",
    "@fontsource/protest-guerrilla": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/spicy-rice": "^5.3.0",
    "@lumphammer/fvtt-telemetry-schema": "github:lumphammer/fvtt-telemetry#path:/packages/schema",
    "@lumphammer/investigator-fvtt-types": "workspace:^",
    "@lumphammer/minirouter": "workspace:^",
    "@lumphammer/shared-fvtt-bits": "workspace:^",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@swc/plugin-emotion": "catalog:",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.3.0",
    "@types/textdiff-create": "^1.0.2",
    "@types/textdiff-patch": "^1.0.2",
    "@types/yamljs": "^0.2.34",
    "@vitejs/plugin-react-swc": "catalog:",
    "@vitest/ui": "^5.0.5",
    "case": "^1.6.3",
    "concurrently": "^10.0.6",
    "focusable-selectors": "^0.8.4",
    "fvtt-types": "catalog:",
    "happy-dom": "catalog:",
    "immer": "^11.2.9",
    "jest-diff": "^30.5.2",
    "json5": "^2.2.3",
    "knip": "^6.43.0",
    "less": "catalog:",
    "nanoid": "^6.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "^5.7.0",
    "textdiff-create": "^1.1.11",
    "textdiff-patch": "^1.1.10",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "catalog:",
    "xss": "^1.0.17",
    "yamljs": "^0.3.0",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
