{
  "include": [
    "index.ts",
    "emotionCompat.ts",
    "themeV2.ts",
    "catalogue.generated.ts",
    "themeV2.typetest.ts"
  ],
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "lib": ["es2020", "dom"]
  }
}
