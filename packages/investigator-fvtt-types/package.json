{
  "name": "@lumphammer/investigator-fvtt-types",
  "version": "1.15.0-alpha.0",
  "description": "TypeScript types for themes and presets for INVESTIGATOR for Foundry VTT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/index.d.ts",
    "dist/themeV2.d.ts",
    "dist/catalogue.generated.d.ts",
    "README.md"
  ],
  "scripts": {
    "prepack": "tsc -p .",
    "test": "tsc",
    "typecheck": "tsc",
    "lint:check": "oxlint --type-aware --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --type-aware --report-unused-disable-directives-severity=error --fix",
    "format:check": "oxfmt --check ./*.ts",
    "format:fix": "oxfmt --write ./*.ts"
  },
  "keywords": [],
  "author": "Neil de Carteret <neil@lumphammer.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumphammer/gumshoe-fvtt.git",
    "directory": "packages/investigator-fvtt-types"
  },
  "homepage": "https://github.com/lumphammer/gumshoe-fvtt/tree/main/packages/investigator-fvtt-types",
  "license": "ISC",
  "devDependencies": {
    "@emotion/serialize": "^1.3.3",
    "csstype": "^3.2.3",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "csstype": "^3.0.2"
  }
}
